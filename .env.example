# Hindsight Cloud
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key-here
HINDSIGHT_BANK_ID=memento-demo-final

# Groq LLM
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# App
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security — SEED_TOKEN is required; /api/seed is disabled without it.
# Set the same value on both backend and frontend (non-public, server-side only).
SEED_TOKEN=change-me-to-a-random-string
